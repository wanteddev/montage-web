{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["../../../docs/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}

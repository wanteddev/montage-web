{
  "name": "@wanteddev/wds",
  "private": true,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "url": "https://github.com/wanteddev/wds",
    "type": "git"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "build": "lerna run build",
    "dev": "lerna run dev --no-cache --continue",
    "lint": "lerna run lint",
    "clean": "pnpm store prune && rm -rf node_modules",
    "test": "lerna run test",
    "lerna-deploy": "lerna publish --include-merged-tags",
    "deploy": "node scripts/deploy.mjs",
    "prepublish": "pnpm run build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "deps:check": "pnpm dlx npm-check-updates@latest --deep",
    "deps:update": "pnpm dlx npm-check-updates@latest -u --deep"
  },
  "packageManager": "pnpm@8.14.3",
  "devDependencies": {
    "@commitlint/cli": "^19.1.0",
    "@commitlint/config-conventional": "^19.1.0",
    "@types/eslint": "^8.56.5",
    "@types/inquirer": "^9.0.7",
    "@types/shelljs": "^0.8.15",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lerna": "^8.1.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2"
  },
  "lint-staged": {
    "*.(ts|tsx)": [
      "eslint --fix --cache --rule react-hooks/exhaustive-deps:off --rule import/order:off"
    ]
  },
  "dependencies": {
    "inquirer": "^9.2.16",
    "shelljs": "^0.8.5",
    "ts-node": "^10.9.2"
  }
}

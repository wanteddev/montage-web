{
  "name": "@wanteddev/wds",
  "private": true,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "url": "https://github.com/wanteddev/wds",
    "type": "git"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "build": "NX_REJECT_UNKNOWN_LOCAL_CACHE=0 lerna run build",
    "dev": "lerna run dev --no-cache --continue",
    "lint": "NX_REJECT_UNKNOWN_LOCAL_CACHE=0 lerna run lint",
    "clean": "pnpm store prune && rm -rf node_modules",
    "watch": "NX_REJECT_UNKNOWN_LOCAL_CACHE=0 lerna watch -- echo \\$LERNA_PACKAGE_NAME \\$LERNA_FILE_CHANGES",
    "test": "vitest run",
    "test:eslint": "pnpm -F eslint-plugin-wds test",
    "test:watch": "vitest",
    "lerna-deploy": "lerna publish --include-merged-tags",
    "deploy": "node scripts/deploy.mjs",
    "prepublish": "pnpm run build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "deps:check": "pnpm dlx npm-check-updates@latest --deep",
    "deps:update": "pnpm dlx npm-check-updates@latest -u --deep",
    "publish:codeconnect": "figma connect publish"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@commitlint/cli": "^19.1.0",
    "@commitlint/config-conventional": "^19.1.0",
    "@figma/code-connect": "^1.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/eslint": "^8.56.5",
    "@types/inquirer": "^9.0.7",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@types/shelljs": "^0.8.15",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "change-case": "^5.4.3",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-eslint-plugin": "^6.5.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "glob": "^10.3.10",
    "husky": "^9.0.11",
    "jscodeshift": "17.1.1",
    "jsdom": "^26.1.0",
    "lerna": "^8.1.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "react": "catalog:react",
    "tsup": "^8.0.2",
    "typescript": "catalog:config",
    "vitest": "^3.2.4",
    "vitest-axe": "1.0.0-pre.5"
  },
  "lint-staged": {
    "*.(ts|tsx)": [
      "eslint --fix --cache"
    ]
  },
  "dependencies": {
    "inquirer": "^9.2.16",
    "shelljs": "^0.8.5",
    "ts-node": "^10.9.2"
  }
}

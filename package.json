{
  "name": "@montage-ui/root",
  "private": true,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "url": "https://github.com/wanteddev/montage-web",
    "type": "git"
  },
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "build": "lerna run build",
    "build:api": "pnpm -F @montage-ui/api-generator build",
    "lint": "lerna run lint",
    "clean": "pnpm store prune && rm -rf node_modules",
    "watch": "lerna watch -- echo \\$LERNA_PACKAGE_NAME \\$LERNA_FILE_CHANGES",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:visual": "pnpm -F @montage-ui/test-visual test",
    "test:visual:watch": "pnpm -F @montage-ui/test-visual test:watch",
    "test:commonjs": "pnpm -F @montage-ui/test-commonjs test",
    "test:e2e": "pnpm -F @montage-ui/test-e2e test",
    "test:treeshaking": "pnpm -F @montage-ui/test-tree-shaking test",
    "lerna-deploy": "lerna publish --include-merged-tags",
    "deploy:packages": "node scripts/deploy.mjs",
    "deploy:docs": "node scripts/docs-deploy.mjs",
    "prepublish": "pnpm run build",
    "size-limit": "size-limit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "deps:check": "pnpm dlx npm-check-updates@latest --deep",
    "deps:update": "pnpm dlx npm-check-updates@latest -u --deep",
    "publish:codeconnect": "figma connect publish"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.4",
    "@figma/code-connect": "^2.1.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.11",
    "change-case": "^5.4.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-vitest-rule-tester": "^3.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jscodeshift": "17.4.0",
    "jsdom": "^26.1.0",
    "lerna": "^10.1.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11",
    "vitest-axe": "1.0.0-pre.5"
  },
  "dependencies": {
    "inquirer": "^9.3.8"
  }
}

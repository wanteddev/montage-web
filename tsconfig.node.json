{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": ["**/node_modules", "**/.*/", "./dist", "*.cjs"],
  "include": [
    "scripts/**/*.mjs",
    ".tsup/**/*.ts",
    "vitest.config.ts",
    ".vitest"
  ]
}

{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true
  },
  "exclude": ["**/node_modules", "**/.*/", "./dist", "*.cjs"],
  "include": [
    "scripts/**/*.mjs",
    "test/**/*.ts",
    ".tsup/**/*.ts",
    "jest.*.js",
    "jest.*.mjs"
  ]
}

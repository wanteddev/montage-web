{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.react.json",
  "compilerOptions": {
    "jsxImportSource": "@emotion/react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
  },
  "include": ["**/*.ts", "**/*.tsx",  ".storybook/**/*.tsx", ".storybook/**/*.ts", "./@types/wds.d.ts"],
  "exclude": ["node_modules"]
}

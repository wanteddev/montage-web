{
  "name": "@wanteddev/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -w run build && node scripts/docgen.mjs && NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "dev-test": "pnpm -w run build && DISABLE_SLUG=true NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "build": "node scripts/docgen.mjs && next build && next-sitemap",
    "build:docgen": "node scripts/docgen.mjs",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@docsearch/react": "^3.6.0",
    "@wanteddev/wds": "workspace:*",
    "@wanteddev/wds-icon": "workspace:*",
    "@wanteddev/wds-lottie": "workspace:*",
    "@wanteddev/wds-nextjs": "workspace:*",
    "copy-to-clipboard": "^3.3.3",
    "glob": "^10.3.10",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.0",
    "lz-string": "^1.5.0",
    "mdx-bundler": "^10.0.1",
    "next": "^14.1.3",
    "next-mdx-remote": "^4.4.1",
    "next-sitemap": "^4.2.3",
    "react": "^18.2.0",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "react-simple-code-editor": "^0.13.1",
    "refractor": "^4.8.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^3.0.1",
    "remark-slug": "^7.0.1",
    "shelljs": "^0.8.5",
    "sucrase": "^3.35.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.1.3",
    "@next/eslint-plugin-next": "^14.1.3",
    "@types/node": "^20.11.25",
    "@types/react": "18.2.65",
    "@types/react-dom": "18.2.22",
    "typescript": "^5.4.2"
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "jsxImportSource": "@emotion/react",
    "types": ["node", "./@types/index.d.ts"],
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "removeComments" :false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}

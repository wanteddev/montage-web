{
  "name": "@montage-ui/brand",
  "description": "Brand asset components for the Montage design system",
  "version": "4.1.5",
  "publishConfig": {
    "access": "public",
    "timeout": 60000
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "types": "./dist/index.d.ts",
      "module": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "url": "https://github.com/wanteddev/montage-web",
    "type": "git",
    "directory": "packages/brand"
  },
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@montage-ui/engine": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}

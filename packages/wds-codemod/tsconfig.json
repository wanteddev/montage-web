{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "commonjs",
    "sourceMap": false,
    "esModuleInterop": true,
    "declaration": false,
    "target": "es2015",
    "downlevelIteration": true,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
  },
  "include": ["bin", "transforms"],
  "exclude": ["node_modules"]
}
